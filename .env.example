# PostgreSQL
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/lock_contention_db

# FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000

# Database connection limits
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

# Monitoring and prediction
SAMPLE_INTERVAL_SEC=2
PREDICTION_HORIZON_SEC=30

# Safety: disabled unless explicitly enabled
EXPERIMENT_MODE_ENABLED=false

# Replace these in the private .env file
ADMIN_API_TOKEN=replace_with_private_token
INTERNAL_API_TOKEN=replace_with_private_token